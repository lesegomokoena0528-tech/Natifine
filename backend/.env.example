# ==========================================================
# NatiFine SA - Environment variables (EXAMPLE)
# Copy to .env and fill in real values. Never commit .env.
# ==========================================================

# --- Flask --------------------------------------------------
FLASK_ENV=development

# Generate strong, unique values for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string

# --- Database: local MySQL (default) ------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=natifine
DB_USER=root
DB_PASSWORD=replace-with-local-password

# --- Database: production override (optional) ---------------
# When DATABASE_URL is set it takes precedence over DB_* above.
# The mysql:// scheme is auto-upgraded to mysql+pymysql://.
# DATABASE_URL=mysql+pymysql://user:password@host:3306/natifine
# DB_SSL=false
# DB_POOL_RECYCLE=280

# --- CORS (comma-separated browser origins) -----------------
# Local dev (Flask serves the frontend) uses this origin.
# Production example: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5000

# --- Uploads ------------------------------------------------
UPLOAD_FOLDER=uploads

# --- Email (SMTP) -------------------------------------------
# Both MAIL_* and SMTP_* names are accepted. For Gmail use an
# App Password (not your normal password) with port 587 + STARTTLS.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=your-address@gmail.com
# Set to true to disable real delivery (e.g. offline demos/tests).
MAIL_SUPPRESS_SEND=false

# --- Optional external integrations (simulated) -------------
SMS_API_KEY=
WHATSAPP_API_KEY=
PAYMENT_API_KEY=

# --- Logging ------------------------------------------------
LOG_LEVEL=INFO
