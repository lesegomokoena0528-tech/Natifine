# ==========================================================
# NatiFine SA - Environment variables (EXAMPLE)
# Copy to .env and fill in real values. Never commit .env.
# ==========================================================

# --- Flask --------------------------------------------------
FLASK_ENV=development

# Generate strong, unique values for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string

# --- Database: local MySQL (default) ------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=natifine
DB_USER=root
DB_PASSWORD=replace-with-local-password

# --- Database: production override (Vercel Postgres/Neon) ----
# When any of these is set it takes precedence over DB_* above.
# Vercel's Neon integration usually provides DATABASE_URL and POSTGRES_URL.
# postgres:// and postgresql:// are auto-upgraded to
# postgresql+psycopg2://.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# POSTGRES_URL=postgresql://user:password@host/db?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require
# POSTGRES_URL_NON_POOLING=postgresql://user:password@host/db?sslmode=require
# DB_POOL_SIZE=2
# DB_MAX_OVERFLOW=3
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=280
# DB_SSL=false

# --- CORS (comma-separated browser origins) -----------------
# Local dev (Flask serves the frontend) uses this origin.
# With Vercel Services the frontend and backend share an origin.
# Production example: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5000

# --- Uploads / Blob storage ---------------------------------
# auto = Vercel Blob when credentials exist, otherwise local disk for development.
# Vercel deployments require Blob credentials and never use local disk.
# Use "local" to force local disk in development, or "vercel_blob" to force Blob.
STORAGE_BACKEND=auto
UPLOAD_FOLDER=uploads
# `vercel env pull` provides these when a Blob store is connected.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# public or private (must match the Blob store's access mode)
BLOB_ACCESS=private
# Vercel Functions cap request bodies at 4.5 MB.
# MAX_CONTENT_LENGTH=4194304

# --- Email (SMTP) -------------------------------------------
# Both MAIL_* and SMTP_* names are accepted. For Gmail use an
# App Password (not your normal password) with port 587 + STARTTLS.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=your-address@gmail.com
# Set to true to disable real delivery (e.g. offline demos/tests).
MAIL_SUPPRESS_SEND=false

# --- Optional external integrations (simulated) -------------
SMS_API_KEY=
WHATSAPP_API_KEY=
PAYMENT_API_KEY=

# --- Logging ------------------------------------------------
LOG_LEVEL=INFO
