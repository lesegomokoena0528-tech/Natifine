# ==========================================================
# NatiFine SA - Git ignore
# ==========================================================

# --- Python -------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Test / tool caches ------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environments ----------------------------------
venv/
.venv/
env/
ENV/
backend/venv/

# --- Environment / secrets ---------------------------------
# Never commit real credentials. Keep .env.example tracked.
.env
.env.*
!.env.example

# --- Runtime / generated data ------------------------------
backend/logs/
backend/instance/
logs/
instance/
exports/
receipts/
uploads/
backend/exports/
backend/receipts/
backend/uploads/

# --- Node ---------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*

# --- OS / editors -------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.log
